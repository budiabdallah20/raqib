# RAQiB — Git ignore (منظّمة من الأعلى: أدوات، بيئات، قاعدة، بناء، نظام)

# ---------- dependencies / builds ----------
node_modules/
.next/
out/
build/*.js
dist/

# ---------- environment (الأسرار ممنوعة، المثال متاح) ----------
.env
.env.local
.env.*.local
.env.bak-*
# المثال الموثّق يبقى متتبع
!.env.example

# ---------- database (dev db + أي نسخ) ----------
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.bak*
*.db.backup-*
prisma/backups/
prisma/*.db.*

# ---------- uploads / storage ----------
storage/
public/uploads/avatars/*
!public/uploads/avatars/.gitkeep
data/
certs/*.pem

# ---------- logs & caches ----------
*.log
npm-debug.log*
.eslintcache
tsconfig.tsbuildinfo
*.tsbuildinfo

# ---------- test payloads ----------
playwright-report/
test-results/
.playwright-cli/

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
*.swp

# ---------- Vercel ----------
.vercel

# ---------- agent workspaces (الويكي فقط متتبع) ----------
.claude/
.opencode/*
!.opencode/wiki/
