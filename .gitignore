# RAQiB — Git ignore (منظّمة من الأعلى: أدوات، بيئات، قاعدة، بناء، نظام)

# ---------- dependencies / builds ----------
node_modules/
.next/
.next-prod/
.next-dev/
out/
build/*.js
dist/

# ---------- environment (الأسرار ممنوعة، المثال متاح) ----------
# أي ملف بيئة أو نسخة احتياطية منه ممنوع يتتبع — إلا المثال الموثّق
.env
.env.*
.env.*.*
.env.bak-*
.env.sqlite-backup
.env.*.backup
!.env.example
# مفاتيح/شهادات TLS محلية
certs/
*.pem
*.key
*.p12
*.pfx

# ---------- database (dev db + أي نسخ) ----------
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.bak*
*.db.backup-*
prisma/backups/
prisma/*.db.*
prisma/schema-*.generated.prisma

# ---------- uploads / storage ----------
storage/
public/uploads/avatars/*
!public/uploads/avatars/.gitkeep
data/
certs/*.pem

# ---------- logs & caches ----------
*.log
npm-debug.log*
.eslintcache
tsconfig.tsbuildinfo
*.tsbuildinfo

# ---------- test payloads ----------
playwright-report/
test-results/
.playwright-cli/

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
*.swp

# ---------- Vercel ----------
.vercel

# ---------- agent workspaces (الويكي فقط متتبع) ----------
.claude/
.opencode/*
!.opencode/wiki/
.neon

# Local review artifacts, backups and agent scratch work
/work/
/coverage/
.next-*/
*.bak
*.backup
*.dump
*.sql
# Keep reviewed SQL migrations if introduced later.
!prisma/migrations/**/*.sql
/hello.ts
/neon.ts
/image.png
