{
  "name": "raqib",
  "version": "0.1.0",
  "private": true,
  "description": "منصة رقيب — نظام إدارة أكاديمية لكلية العلوم جامعة السويس",
  "scripts": {
    "dev": "next dev --turbopack --experimental-https --experimental-https-key certs/localhost+2-key.pem --experimental-https-cert certs/localhost+2.pem",
    "dev:http": "next dev --turbopack",
    "dev:https": "node server.mjs --dev",
    "build": "prisma generate && next build",
    "start": "node server.mjs",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "node scripts/db-verify.mjs",
    "db:audit": "node scripts/db-audit.mjs",
    "db:audit:cleanup": "node scripts/db-cleanup-audit.mjs",
    "db:purge-demo": "node scripts/db-purge-demo.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "storage:migrate": "node scripts/migrate-storage.mjs",
    "security:env": "node scripts/security-env.mjs",
    "admin:code": "node scripts/admin-code.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "backup:db": "node scripts/db-backup.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "tsc --noEmit && next build && vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.11.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.454.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.0.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.23",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vercel": "^65.4.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.0": true,
    "esbuild@0.27.7": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  }
}
