# RAQiB · متغيرات البيئة — انسخه إلى .env (تطوير) و إلى Environment Variables على Vercel (إنتاج)
# جميع القيم هنا أمثلة — استبدلها بقيم حقيقية ولا ترفع الأسرار للجيتهو

# ---------- القاعدة ----------
# تطوير (SQLite محلي):
DATABASE_URL="file:./dev.db"
# إنتاج (Postgres): DATABASE_URL="postgresql://user:pass@host:5432/raqib?schema=public&sslmode=require"

# ---------- المصادقة ----------
# سر توقيع JWT — ولّده بـ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-64-char-random-string"

# كود الدخول للإدارة (هاش bcrypt-12) — ولّده بـ: node scripts/admin-code.mjs
ADMIN_ACCESS_CODE_HASH=""

# ---------- الصلاحيات ----------
# Trust X-Forwarded-* headers خلف بروكسي (Vercel/Nginx): 1 = نعم
TRUST_PROXY="0"

# ---------- الموقع ----------
# الرابط العام للمنصة — يتطابق مع الدومين النهائي على Vercel (مثال: https://hadour.com)
# يُستخدم في metadata/OG/robots — يجب أن يبدأ بـ https:// في الإنتاج
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT="3000"

# ---------- البريد (Resend) — اختياري لاستعادة كلمة المرور ----------
RESEND_API_KEY=""
MAIL_FROM="RAQiB <onboarding@resend.dev>"

# ---------- العرض التجريبي ----------
# يسمح بـ /api/admin/demo/reset — لا تفعّله في الإنتاج
ALLOW_DEMO_RESET="0"

# ---------- كود إعادة التعيين في التطوير ----------
# يظهر كود إعادة التعيين مباشرة في استجابة /api/auth/forgot أثناء التطوير — اجعله 0 لإخفائه
SHOW_DEV_RESET_CODE="1"

# ---------- بصمة الجهاز (Passkey / WebAuthn) ----------
# لما تنشر على دومين حقيقي: PASSKEY_RP_ID=yourdomain.com (بدون https ولا مسار)
PASSKEY_RP_ID="localhost"
# اختياري: origin إضافي مقبول للتحقق (مثلاً معاينات Vercel)
# PASSKEY_ORIGIN="https://your-preview.vercel.app"
