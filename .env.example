# ── قاعدة البيانات ──
# تطوير (SQLite):  file:./dev.db
# إنتاج (Postgres): postgres://user:pass@host:5432/raqib
DATABASE_URL="file:./dev.db"

# ── الأمان (إلزامي) ──
# 48 بايت عشوائية على الأقل. ولّده/دوّره بـ: npm run security:env -- --rotate
JWT_SECRET="change-me-to-a-random-string-min-32-chars"
# كود الأدمن (16 رقمًا) — bcrypt. ولّده بـ: npm run admin:code
# الهاش يُكتب بين علامتي اقتباس مع هروب $ (مثال: "\$2a\$12\$...")
ADMIN_ACCESS_CODE_HASH="\$2a\$12\$replace-with-your-own-bcrypt-hash"

# ── التشغيل ──
# لا تضبط NODE_ENV هنا: الوضع يُحدَّد بالأمر — npm run dev:https (تطوير)
# أو npm run build ثم npm start (إنتاج). ضبطها هنا يخلط بين الوضعين.
PORT=5000
NEXT_PUBLIC_APP_URL="https://localhost:5000"

# ── الشبكة والوكيل العكسي ──
# 1 فقط إذا كان السيرفر خلف Nginx/Cloudflare موثوق (يسمح بقراءة X-Forwarded-For)
TRUST_PROXY="0"

# ── أدوات الديمو ──
# 1 يسمح بإعادة ضبط بيانات العرض من لوحة الأدمن — ممنوع في production
ALLOW_DEMO_RESET="1"

# ── البريد (اختياري — fallback الكونسول) ──
RESEND_API_KEY=""
MAIL_FROM="Raqib <no-reply@raqib.app>"

# ── تطوير فقط ──
# 1 (الافتراضي) يطبع كود إعادة الضبط في كونسول السيرفر في وضع التطوير.
# ضعها "0" لمنع ظهور الكود حتى في التطوير.
# SHOW_DEV_RESET_CODE="1"

# ── إنتاج إضافي (اختياري) ──
# REDIS_URL="redis://localhost:6379"      # تحوّل rate-limit إلى Redis عند الوجود
# SENTRY_DSN=""                            # مراقبة أخطاء
# BACKUP_DIR="prisma/backups"               # مجلد نسخ db:backup
