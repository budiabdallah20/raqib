# RAQIB environment template. Copy to .env for local development only.
# Never commit real credentials. Set production values in Vercel project settings.

# Local SQLite. Production uses the existing Neon PostgreSQL database.
DATABASE_URL="file:./dev.db"
# Required for PostgreSQL schema tools; use the matching direct (non-pooler) URL.
DATABASE_URL_UNPOOLED=""

# Server-only secrets. Generate independent secrets for isolated environments.
# JWT: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# PII: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Preserve this key for an existing database; replacing it makes encrypted data unreadable.
PII_ENCRYPTION_KEY=""
# Generate the bcrypt hash with: node scripts/admin-code.mjs
# Never set ADMIN_ACCESS_CODE in production.
ADMIN_ACCESS_CODE_HASH=""

# Public URL only (this value is exposed to browsers).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT="3000"
# Set to 1 only behind a trusted proxy, including Vercel.
TRUST_PROXY="0"
SHOW_DEV_RESET_CODE="0"

# WebAuthn: production must match https://raqibdev.vercel.app exactly.
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:3000"

# Optional password-recovery email. Configure a verified sender before enabling.
RESEND_API_KEY=""
MAIL_FROM="RAQIB <onboarding@resend.dev>"

# Optional Google Drive integration: configure the complete OAuth set together.
GDRIVE_CLIENT_ID=""
GDRIVE_CLIENT_SECRET=""
GDRIVE_REFRESH_TOKEN=""
GDRIVE_ROOT_FOLDER_ID=""
GDRIVE_ROOT_FOLDER_NAME="RAQIB"
